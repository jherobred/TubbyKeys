{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "visualizer-overlay",
  "description": "Visualizer overlay: read settings, and drag itself while being arranged.",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-arrange-overlay",
    "core:window:allow-start-dragging"
  ]
}
