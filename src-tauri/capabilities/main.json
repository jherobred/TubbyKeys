{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings window: every app command, no plugin access.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-update-settings",
    "allow-preview-pack",
    "allow-market-list",
    "allow-market-install",
    "allow-remove-pack",
    "allow-open-packs-folder",
    "allow-open-link",
    "allow-show-settings",
    "allow-quit-app"
  ]
}
