{
  "schema": 1,
  "id": "alpaca",
  "name": "Alpaca",
  "version": "1.0.0",
  "author": "Thomas Lai (kbsim)",
  "license": "MIT",
  "source": "https://github.com/tplai/kbsim",
  "type": "linear",
  "description": "Smooth linear with a soft, muted clack.",
  "press": {
    "rows": [
      [
        "press/GENERIC_R0.mp3"
      ],
      [
        "press/GENERIC_R1.mp3"
      ],
      [
        "press/GENERIC_R2.mp3"
      ],
      [
        "press/GENERIC_R3.mp3"
      ],
      [
        "press/GENERIC_R4.mp3"
      ]
    ],
    "space": [
      "press/SPACE.mp3"
    ],
    "enter": [
      "press/ENTER.mp3"
    ],
    "backspace": [
      "press/BACKSPACE.mp3"
    ]
  },
  "release": {
    "default": [
      "release/GENERIC.mp3"
    ],
    "space": [
      "release/SPACE.mp3"
    ],
    "enter": [
      "release/ENTER.mp3"
    ],
    "backspace": [
      "release/BACKSPACE.mp3"
    ]
  }
}
